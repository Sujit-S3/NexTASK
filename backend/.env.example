NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your_refresh_token_secret_also_change_this_in_production
JWT_REFRESH_EXPIRE=30d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gemini API Key (Required for AI assistant panel)
GEMINI_API_KEY=your_gemini_api_key_here
